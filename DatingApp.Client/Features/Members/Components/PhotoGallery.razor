@if (Member is not null
&& Member.Photos.Count > 0
&& SpinnerService.HoldSpinner == false)
{
    <MudCarousel Class="d-flex mx-auto mb-2"
             @ref="_carousel"
             ItemsSource="@Member.Photos"
             @bind-SelectedIndex="_position"
             ShowArrows="true"
             ShowBullets="false"
             AutoCycle="false"
             Style="width: 100%; height: 500px;">
        <ItemTemplate>
            <MudContainer Class="d-flex justify-center px-0">
                <MudImage Class="rounded-lg"
                      Src="@context.Filename"
                      Width="500"
                      Height="500"
                      Fluid="true" />
            </MudContainer>
        </ItemTemplate>
    </MudCarousel>
    <MudText Typo="Typo.caption" Align="Align.Center" Class="mb-4 app-muted">
        Photo @(_position + 1) of @Member.Photos.Count
    </MudText>

    <MudGrid>
        @for (int i = 0; i < Member.Photos.Count; i++)
        {
            int index = i;

            <MudItem xs="6" sm="4" lg="3" xl="2" Class="d-flex justify-center">

                <MudImage Class="rounded-lg"
                  Src="@Member.Photos[index].Filename"
                  Width="250"
                  Height="250"
                  Fluid="true"
                  @onclick="() => HandleThumbnailClick(index)" />

            </MudItem>
        }
    </MudGrid>
}
else 
{
    <MudText Align="Align.Center" Typo="Typo.h5">No photos available</MudText>
}

@code {
    [Inject] public required ISpinnerService SpinnerService { get; set; }
    [Inject] public required IPhotoService PhotoService { get; set; }
    [Parameter] public required MemberResponse Member { get; set; }

    private MudCarousel<PhotoResponse> _carousel = null!;
    private int _position = 0;

    protected override async Task OnParametersSetAsync()
    {
        SpinnerService.HoldSpinner = true;

        foreach (PhotoResponse p in Member.Photos)
        {
            p.Filename = await PhotoService.GetPhotoAsync(Member.Username, p.Filename);
        }

        SpinnerService.HoldSpinner = false;
        await base.OnParametersSetAsync();
    }

    private void HandleThumbnailClick(int index)
    {
        _position = index;
    }
}

